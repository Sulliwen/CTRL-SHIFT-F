{
  "manifest_version": 3,
  "name": "Ctrl+Shift+F",
  "version": "0.1.0",
  "description": "Recherche sémantique et syntaxique dans la page, 100 % locale. Ouvrir avec Ctrl+Shift+F.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Ctrl+Shift+F — recherche sémantique dans la page"
  },
  "commands": {
    "toggle-search": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "Command+Shift+F" },
      "description": "Ouvrir ou fermer la recherche sémantique"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": { "id": "ctrl-shift-f@sulliwen.github.io", "strict_min_version": "128.0" }
  }
}
