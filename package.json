{
  "name": "ctrl-shift-f",
  "version": "0.1.0",
  "description": "Recherche sémantique et syntaxique dans la page courante, déclenchée par Ctrl+Shift+F. 100 % locale.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "e2e": "node scripts/build.mjs --e2e && node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bench": "node scripts/bench-models.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
